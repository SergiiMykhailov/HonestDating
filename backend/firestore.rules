rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // This is the initial owner-only account record created immediately after
    // successful Firebase Authentication. Debug builds have one deliberately
    // constrained anonymous-preview variant. No profile or verification data
    // is client writable here.
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && (
          (
            request.resource.data.keys().hasOnly([
              'schemaVersion',
              'createdAt',
              'updatedAt',
            ])
            && request.resource.data.schemaVersion == 1
            && request.resource.data.createdAt == request.time
            && request.resource.data.updatedAt == request.time
          )
          || (
            request.auth.token.debugPreview == true
            &&
            request.resource.data.keys().hasOnly([
              'schemaVersion',
              'email',
              'accountKind',
              'createdAt',
              'updatedAt',
            ])
            && request.resource.data.schemaVersion == 1
            && request.resource.data.email == 'folia.dummy@gmail.com'
            && request.resource.data.accountKind == 'debugPreview'
            && request.resource.data.createdAt == request.time
            && request.resource.data.updatedAt == request.time
          )
        );
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'updatedAt',
            'registrationCompletedAt',
            'email',
            'accountKind',
          ])
        && request.resource.data.updatedAt == request.time
        && (
          (
            !resource.data.keys().hasAll(['email', 'accountKind'])
            && !request.resource.data.keys().hasAll(['email', 'accountKind'])
          )
          || (
            resource.data.keys().hasAll(['email', 'accountKind'])
            && request.resource.data.keys().hasAll(['email', 'accountKind'])
            && request.resource.data.email == resource.data.email
            && request.resource.data.accountKind == resource.data.accountKind
          )
          || (
            request.auth.token.debugPreview == true
            && !resource.data.keys().hasAll(['email', 'accountKind'])
            && request.resource.data.keys().hasAll(['email', 'accountKind'])
            && request.resource.data.email == 'folia.dummy@gmail.com'
            && request.resource.data.accountKind == 'debugPreview'
          )
        )
        && (
          (
            !resource.data.keys().hasAll(['registrationCompletedAt'])
            && !request.resource.data.keys().hasAll(['registrationCompletedAt'])
          )
          || (
            resource.data.keys().hasAll(['registrationCompletedAt'])
            && request.resource.data.keys().hasAll(['registrationCompletedAt'])
            && request.resource.data.registrationCompletedAt
              == resource.data.registrationCompletedAt
          )
          || (
            !resource.data.keys().hasAll(['registrationCompletedAt'])
            && request.resource.data.keys().hasAll(['registrationCompletedAt'])
            && request.resource.data.registrationCompletedAt == request.time
          )
        );
      allow delete: if false;
    }

    // Identity verification, biometric-consent, and photo-verification state
    // are server-owned. Client applications must never access this data.
    match /users/{userId}/private/{document=**} {
      allow read, write: if false;
    }

    // A member's discoverable profile is public only to other authenticated
    // members. Profile and profile-media writes are server-owned; a mobile
    // client cannot create, modify, or delete either record.
    match /users/{userId}/profiles/{profileId} {
      allow get, list: if request.auth != null;

      match /media/{mediaId} {
        allow get, list: if request.auth != null;
      }
    }

    // Discover loads profiles with a collection-group query. Firestore rules
    // must authorize that query explicitly; the fixed users path above is not
    // sufficient for a collection-group read.
    match /{path=**}/profiles/{profileId} {
      allow get, list: if request.auth != null;
    }

    // Viewer-specific relationship projections are stored below the viewer's
    // own account. They are written atomically by the relationship service;
    // mobile clients can read only their own projection.
    match /users/{userId}/relationships/{profileId} {
      allow get, list: if isOwner(userId);
      allow write: if false;
    }

    // Cloud Run maintains one private conversation projection per member. The
    // app can read only its own projection and message copies.
    match /users/{userId}/conversations/{conversationId} {
      allow get, list: if isOwner(userId);
      allow write: if false;

      match /messages/{messageId} {
        allow get, list: if isOwner(userId);
        allow write: if false;
      }
    }

    // Canonical pair state is backend-only and never exposed to a client.
    match /users/{userId}/privateRelationships/{pairId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
